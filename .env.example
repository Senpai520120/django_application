# Скопируйте в .env и заполните.
# Ключ: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

DEBUG=True

# Через запятую, без пробелов.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Не задано — SQLite-файл db.sqlite3 в корне проекта.
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://users_roles:users_roles@localhost:5432/users_roles

TIME_ZONE=UTC

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Файловый менеджер: local — диск сервера, s3 — бакет AWS.
FILE_STORAGE_BACKEND=local
FILE_MANAGER_ROOT=filemanager
FILE_MANAGER_MAX_FILE_SIZE=26214400
FILE_MANAGER_MAX_TOTAL_SIZE=536870912

# Нужны только при FILE_STORAGE_BACKEND=s3.
# На EC2 ключи не задаются: доступ выдаётся IAM-ролью инстанса.
FILE_MANAGER_S3_LOCATION=filemanager
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Для локального S3-эмулятора (localstack):
# AWS_S3_ENDPOINT_URL=http://localstack:4566
# AWS_S3_ADDRESSING_STYLE=path

# По умолчанию: обычное хранилище при DEBUG=True, whitenoise-манифест при False.
# STATICFILES_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage

# Включать за TLS-терминирующим прокси, иначе SECURE_SSL_REDIRECT зациклится.
USE_X_FORWARDED_PROTO=False

# Включать только за HTTPS, иначе браузер не сохранит cookie.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# За HTTPS-прокси, например: https://example.com
# CSRF_TRUSTED_ORIGINS=
