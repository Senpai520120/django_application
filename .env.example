# Скопируйте этот файл в .env и заполните значения.
# Сгенерировать ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# В проде обязательно False.
DEBUG=True

# Через запятую, без пробелов.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# По умолчанию (если переменная не задана) — SQLite-файл db.sqlite3 в корне
# проекта. Раскомментируйте нужную строку, чтобы переопределить.
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL:
# DATABASE_URL=postgres://users_roles:users_roles@localhost:5432/users_roles

# Часовой пояс приложения.
TIME_ZONE=UTC

# Хранилище статики. По умолчанию: StaticFilesStorage при DEBUG=True и
# whitenoise-манифест при DEBUG=False (тогда нужен `manage.py collectstatic`).
# STATICFILES_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage

# Включайте только когда сайт реально работает по HTTPS,
# иначе браузер не сохранит cookies и логин перестанет работать.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Нужно за HTTPS-прокси, например: https://example.com
# CSRF_TRUSTED_ORIGINS=
