#!/bin/bash
set -euxo pipefail

# Docker из официального репозитория Ubuntu-пакетов.
apt-get update
apt-get install -y docker.io docker-compose-v2

systemctl enable --now docker

install -d -m 0750 /opt/app
cd /opt/app

# Секреты пишутся на инстансе, в репозитории их нет.
cat > .env <<ENV
SECRET_KEY=${secret_key}
DEBUG=False
ALLOWED_HOSTS=*
DATABASE_URL=postgres://users_roles:${db_password}@db:5432/users_roles
FILE_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=${bucket}
AWS_S3_REGION_NAME=${region}
FILE_MANAGER_S3_LOCATION=filemanager
SEED_DEMO_USERS=1
USE_X_FORWARDED_PROTO=False
ENV
chmod 0640 .env

# Ключи AWS не задаются намеренно: boto3 возьмёт временные креды
# из IAM-роли инстанса через IMDSv2.
cat > compose.yaml <<COMPOSE
services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: users_roles
      POSTGRES_USER: users_roles
      POSTGRES_PASSWORD: ${db_password}
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: always
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U users_roles"]
      interval: 5s
      retries: 10

  web:
    image: ${image}
    env_file: [.env]
    ports:
      - "80:8000"
    restart: always
    depends_on:
      db:
        condition: service_healthy

volumes:
  pgdata:
COMPOSE

docker compose -f compose.yaml up -d
